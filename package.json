{
  "name": "dsh-maibot-artifacts",
  "version": "0.3.0",
  "description": "DSH Cordis bundle for verifiable MaiBot artifact handoff",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "docs"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/MemoryController/dsh-maibot-artifacts.git"
  },
  "engines": {
    "node": ">=24",
    "dsh": "0.2.2-alpha.2"
  },
  "os": [
    "linux"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --test-isolation=none test/*.test.ts",
    "lint": "eslint src test scripts",
    "verify:dist": "node scripts/verify-dist.mjs",
    "test:install": "node scripts/test-install.mjs",
    "check": "npm run typecheck && npm run lint && npm test && npm run verify:dist && npm run test:install && npm run test:profile && npm run test:acp",
    "test:profile": "node scripts/test-profile.mjs",
    "test:acp": "node scripts/test-acp.mjs",
    "test:acp:clean": "node scripts/test-acp.mjs --clean-install",
    "test:version": "node scripts/test-version.mjs",
    "test:handoff": "node scripts/test-handoff.mjs",
    "test:legacy-peer": "node scripts/test-legacy-peer.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.6-alpha.1",
    "@deepseek-ai/dsh-llm": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-tools": "0.2.2-alpha.2"
  },
  "devDependencies": {
    "@agentclientprotocol/sdk": "1.4.0",
    "@deepseek-ai/cordis": "4.0.6-alpha.1",
    "@deepseek-ai/dsh": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-llm": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-mcp-client": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-scope": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-tool-executor-native": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-tool-executor-ptc": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-tools": "0.2.2-alpha.2",
    "@eslint/js": "9.39.1",
    "@types/node": "24.10.0",
    "eslint": "9.39.1",
    "pnpm": "11.25.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.48.1"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.6-alpha.1"
  }
}
